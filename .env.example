# ──────────────────────────────────────────────
# Snipli — Environment Variables Template
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# --- Backend Configuration ---
# Base URL used for constructing short URLs
SNIPLI_BASE_URL=https://snipli.io

# API key for authenticating client requests (stored in Secret Manager in prod)
SNIPLI_API_KEY=your-api-key-here

# Google Cloud project ID
GCP_PROJECT_ID=your-gcp-project-id

# Cloud Tasks handler URL (the internal endpoint Cloud Tasks calls)
SNIPLI_TASKS_HANDLER_URL=https://your-backend-cloud-run-url/internal/tasks/record-click

# Redis connection (Memorystore in production, localhost in local dev)
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_KEY=your-api-key-here
